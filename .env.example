# ---------------------------------------------------------------------------
# Copy to .env.local for development. Also copy DATABASE_URL into .env, which
# is what the Prisma CLI reads (see prisma7.config.ts).
# ---------------------------------------------------------------------------

# --- Admin panel: database ---
# Matches docker-compose.yml. Port 5433 avoids clashing with a system Postgres.
DATABASE_URL="postgresql://fe_admin:fe_admin_local@localhost:5433/fe_website?schema=public"

# --- Admin panel: secrets ---
# Encrypts the admin session cookie. Minimum 32 characters.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Guards the draft-mode preview entrypoint
ADMIN_PREVIEW_SECRET=

# Bearer token for the scheduled-publish cron endpoint
# (GET /api/admin/cron/publish with "Authorization: Bearer <token>")
ADMIN_CRON_SECRET=

# --- Admin panel: first Super Admin (used by `npm run admin:seed`) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME="Super Admin"

# --- Email delivery (Resend) — required in production for form submissions ---
RESEND_API_KEY=

# Sender address — must be a verified domain in Resend (defaults to onboarding@resend.dev in dev)
EMAIL_FROM="First Economy <hello@firsteconomy.com>"

# Inbox routing (comma-separated for multiple recipients)
CONTACT_NOTIFICATION_EMAIL=hello@firsteconomy.com
CAREERS_NOTIFICATION_EMAIL=careers@firsteconomy.com
NEWSLETTER_NOTIFICATION_EMAIL=hello@firsteconomy.com

# --- Public site: SEO ---
# Public origin used for canonical, og:url, sitemap and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://www.firsteconomy.com"

# Tag Manager container already used by the live site (default shown). Set to an empty string to turn tracking off.
# Loads only in production builds on the site hostname, never on staging (SITE_NOINDEX) or /admin.
# NEXT_PUBLIC_GTM_ID="GTM-THFF9GV"
# Set to "true" on STAGING/PREVIEW only: adds noindex meta + X-Robots-Tag and disallows all in
# robots.txt. Leave unset in production.
# SITE_NOINDEX=true
